{
  "version": 3,
  "framework": {
    "name": "nitro",
    "version": "3.0.260610-beta"
  },
  "overrides": {},
  "routes": [
    {
      "src": "/assets/login-BPZCp6gH.js",
      "dest": "/assets/login-ht-v6.js",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    {
      "src": "/assets/login-ht-v5.js",
      "dest": "/assets/login-ht-v6.js",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    {
      "src": "/assets/client-bLCk0icn.js",
      "dest": "/assets/client-ht-v4.js",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    {
      "src": "/(.*)",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate, max-age=0"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/__server"
    }
  ]
}
