{
  "version": 3,
  "framework": {
    "name": "nitro",
    "version": "3.0.260610-beta"
  },
  "overrides": {},
  "routes": [
    {
      "src": "/assets/client-bLCk0icn.js",
      "dest": "/assets/client-ht-v4.js",
      "headers": {
        "cache-control": "no-store, max-age=0"
      }
    },
    {
      "headers": {
        "cache-control": "public, max-age=60, must-revalidate"
      },
      "src": "/assets/(.*)"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/__server"
    }
  ]
}
